# =============================================================================
# CareerPilot AI — environment template
# Copy to .env (apps/api/.env and apps/web/.env.local as needed) and fill in.
# NEVER commit real secrets.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# Local dev defaults to SQLite (no external DB required).
# For production, use PostgreSQL and run `prisma migrate deploy`.
DATABASE_URL="file:./dev.db"

# ---- API server -------------------------------------------------------------
PORT=4000
API_BASE_URL="http://localhost:4000"

# ---- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET=""

# ---- AI Provider ------------------------------------------------------------
# Options: "openai-compatible" | "heuristic" (offline fallback, no key needed)
AI_PROVIDER="heuristic"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# ---- Email notifications ----------------------------------------------------
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

# ---- Queue ------------------------------------------------------------------
# Local dev uses an in-memory scheduler. Set REDIS_URL to enable BullMQ.
REDIS_URL=""

# ---- Browser automation -----------------------------------------------------
PLAYWRIGHT_HEADLESS="true"
PLAYWRIGHT_USER_DATA_DIR=""

# ---- n8n integration (optional) --------------------------------------------
N8N_WEBHOOK_URL=""

# ---- Security ---------------------------------------------------------------
# Comma-separated list of allowed web origins for CORS
CORS_ORIGINS="http://localhost:3000"
